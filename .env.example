DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Los_Angeles
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

LITEBOOKS_PORT=8000
LITEBOOKS_MANAGE_PY=manage.py
LITEBOOKS_WAIT_FOR_DB=true
LITEBOOKS_AUTO_MIGRATE=true
LITEBOOKS_COLLECT_STATIC=false
LITEBOOKS_HEALTHCHECK_URL=http://127.0.0.1:8000/healthz/

# Software updates. LITEBOOKS_TAG is the image tag currently deployed; the
# updater rewrites it in place when an update succeeds.
LITEBOOKS_TAG=main
LITEBOOKS_UPDATER_TAG=main
LITEBOOKS_UPDATES_ENABLED=true
LITEBOOKS_UPDATE_REPO=LiteBooks/LiteBooks
LITEBOOKS_UPDATE_BRANCH=main
LITEBOOKS_UPDATE_IMAGE=ghcr.io/litebooks/litebooks
LITEBOOKS_UPDATE_CHECK_INTERVAL=86400
# Optional: raises the GitHub API rate limit for update checks.
# LITEBOOKS_GITHUB_TOKEN=

POSTGRES_DB=litebooks
POSTGRES_USER=litebooks
POSTGRES_PASSWORD=replace-with-a-long-random-value

